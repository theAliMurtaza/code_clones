# ─────────────────────────────────────────────────────────────────────
# CloneScope Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────
APP_NAME=CloneScope API
APP_VERSION=1.0.0
DEBUG=false

# Origins allowed to call the API (comma-separated)
# Add your Vite dev server and production domain here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ── PostgreSQL ────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://clonescope:clonescope@localhost:5432/clonescope

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_TTL=86400      # seconds — 24 hours

# ── Celery (uses Redis as broker) ────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_URL=redis://localhost:6379/2

# ── Auth — JWT ───────────────────────────────────────────────────────
# IMPORTANT: generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE-ME-USE-A-LONG-RANDOM-STRING-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ── CodeBERT model ───────────────────────────────────────────────────
CODEBERT_MODEL=microsoft/codebert-base
# Set to true on AWS EC2 GPU instances (NFR-08-02)
USE_GPU=false
# Where to cache downloaded HuggingFace model weights
MODEL_CACHE_DIR=./model_cache
# How many fragments to embed per GPU batch (NFR-08-01)
BATCH_SIZE=16
MAX_TOKEN_LENGTH=512

# ── Clone detection thresholds ───────────────────────────────────────
DEFAULT_THRESHOLD=0.75      # minimum cosine similarity to report a pair
TYPE1_TOKEN_SIM=0.97        # token similarity for Type-1 (exact)
TYPE2_SEM_SIM=0.93          # semantic similarity for Type-2
TYPE2_TOK_SIM=0.82          # token similarity for Type-2
TYPE3_SEM_SIM=0.84          # semantic similarity for Type-3

# ── File handling ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
SUPPORTED_EXTS=.py,.java    # comma-separated
CODE_RETENTION_DAYS=30      # NFR-03-02: auto-delete after this many days
